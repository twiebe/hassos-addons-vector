{
  "backend": "victorialogs",
  "options": {
    "sink_type": "victorialogs",
    "sink_victorialogs": {
      "endpoint": "@ENDPOINT@/insert/elasticsearch"
    }
  },
  "expect": {
    "started": true,
    "record": [
      ".line | contains(\"e2e\")",
      ".fields.host != null",
      "(.fields.CONTAINER_NAME // .fields._SYSTEMD_UNIT) != null",
      ".fields._PID != null"
    ]
  }
}
